# Optional: copy to .env and adjust before starting Docker Compose.
ONTOLENS_PORT=8080
# Windows example: D:/OntoLensData (must already exist and be writable)
ONTOLENS_DATA_DIR=./docker-data
# Local drive/folder for the file chooser (read/write). Compose defaults to C:/.
# Adjust BEFORE the first start. Use D:/ for a Windows D drive, or a specific folder.
# Linux/macOS: use an existing absolute host path instead, e.g. /home/me/ontologies.
ONTOLENS_HOST_DIR=D:/
